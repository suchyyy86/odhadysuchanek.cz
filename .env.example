# Odesílání poptávek z formuláře (funkce api/poptavka.ts, služba Resend – stejně jako zonetic.cz).
# Na Vercelu se nastavuje v Settings → Environment Variables. Pro lokální zkoušku zkopírujte do .env.
# Bez RESEND_API_KEY běží `npm run dev` nanečisto: e-mail se neodešle, jen se vypíše do konzole.

# Klíč z resend.com
RESEND_API_KEY=

# Kam mají poptávky chodit. Víc adres oddělte čárkou – poptávka pak přijde všem.
CONTACT_EMAIL=

# Odesílatel. Doména za zavináčem musí být v Resendu ověřená.
CONTACT_FROM="Web odhadysuchanek.cz <poptavka@odhadysuchanek.cz>"
