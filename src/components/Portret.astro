---
// Fotka v úvodu. Dokud ve složce src/assets není soubor portret.jpg (nebo .jpeg, .png, .webp),
// zobrazí se zástupná silueta. Jakmile tam fotku uložíte, použije se sama – nic dalšího se nemění.
// Současná fotka je výřez z většího snímku, vyrábí ho scripts/portret.mjs.
import { Image } from 'astro:assets';
import { uvod } from '../data/site';

const fotky = import.meta.glob<{ default: ImageMetadata }>('../assets/portret.{jpg,jpeg,png,webp}', {
  eager: true,
});
const fotka = Object.values(fotky)[0]?.default;
---

<div class="portret">
  {
    fotka ? (
      <Image
        class="portret__obraz"
        src={fotka}
        alt={uvod.fotka}
        widths={[416, 640, 832, 1080]}
        sizes="(min-width: 60em) min(26rem, 36vw), min(26rem, 92vw)"
        loading="eager"
        fetchpriority="high"
      />
    ) : (
      <svg class="portret__obraz portret__obraz--zastupny" viewBox="0 60 320 320" role="img" aria-label="Fotografie bude doplněna">
        <rect width="320" height="400" class="portret__pozadi" />
        <circle cx="160" cy="158" r="62" class="portret__silueta" />
        <path d="M34 400c6-84 58-132 126-132s120 48 126 132z" class="portret__silueta" />
      </svg>
    )
  }
</div>
