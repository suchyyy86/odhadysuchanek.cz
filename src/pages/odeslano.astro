---
// Sem funkce api/poptavka.ts přesměruje, když se formulář odešle klasicky (bez JavaScriptu).
import Base from '../layouts/Base.astro';
import { kontakt, znalec } from '../data/site';
import { pevne } from '../utils/cz';
---

<Base title="Poptávka odeslána | Ing. Bohdan Suchanek" noindex>
  <article class="obal stranka">
    <div class="stranka__obsah">
      <h1>{kontakt.formular.hotovoNadpis}</h1>
      <p>{kontakt.formular.hotovoText}</p>
      <p>
        Kdyby to spěchalo, zavolejte na <a href={znalec.telefonOdkaz}>{pevne(znalec.telefon)}</a>.
      </p>
      <a class="tlacitko tlacitko--zlate" href="/">Zpět na úvod</a>
    </div>
  </article>
</Base>
